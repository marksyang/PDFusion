{
  "name": "pdfusion",
  "version": "1.0.8",
  "description": "Cross-platform PDF editor for macOS and Windows (pdfium via Rust core + pdf-lib)",
  "main": "./out/main/index.js",
  "author": "Mark Yang",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "core:build": "napi build --cwd core --platform --js index.js --dts index.d.ts",
    "core:build:release": "napi build --cwd core --platform --release --js index.js --dts index.d.ts",
    "package:mac": "npm run core:build:release && npm run build && electron-builder --mac",
    "package:win": "npm run core:build:release && npm run build && electron-builder --win",
    "test:core": "node scripts/core-smoke.mjs",
    "test:all": "npm run test && npm run test:core"
  },
  "dependencies": {
    "fontkit": "^2.0.4",
    "pdf-lib": "^1.17.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.9.1",
    "@types/node": "^22.10.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  }
}
